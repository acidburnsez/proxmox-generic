# Secret variable files — never commit these
*.tfvars
!*.tfvars.example
!ci.tfvars

# Terraform state — contains sensitive data
*.tfstate
*.tfstate.backup

# Local Terraform data
.terraform/

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
