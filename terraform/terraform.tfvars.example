# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it.

# ── Proxmox connection ────────────────────────────────────────────────────────
proxmox_endpoint  = "https://192.168.1.10:8006/"
proxmox_host      = "192.168.1.10"   # same IP, without https:// and port
proxmox_api_token = "terraform@pve!terraform=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_insecure  = true   # set false if you have a valid TLS cert
proxmox_ssh_user  = "root"

# ── Node defaults ─────────────────────────────────────────────────────────────
proxmox_node     = "prox"
default_storage  = "local-lvm"
template_storage = "local"
default_bridge   = "vmbr0"
default_gateway  = "192.168.1.1"

# ── SSH key ───────────────────────────────────────────────────────────────────
# Paste your public key (run: cat ~/.ssh/id_ed25519.pub)
ssh_public_key = "ssh-ed25519 AAAAC3... you@host"
